{
  "manifest_version": 3,
  "key": "",
  "name": "Maya Browser Companion — Developer Capture",
  "version": "0.2.0",
  "description": "Privileged Maya developer build with Chromium DOMSnapshot and AXTree capture.",
  "permissions": ["activeTab", "contextMenus", "debugger", "nativeMessaging", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "module"},
  "side_panel": {"default_path": "sidepanel.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "action": {"default_title": "Open Maya Developer Capture"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
