# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional — external subtitles (OpenSubtitles via Wyzie / official API)
# Free Wyzie key: https://store.wyzie.io/redeem
# WYZIE_API_KEY=
# English-only by default (saves Wyzie free-tier quota)
# SUBTITLE_LANGUAGE=en
# Or official OpenSubtitles: https://www.opensubtitles.com/en/consumers
# OPENSUBTITLES_API_KEY=

# Optional
# TMDB_READ_TOKEN=
# PORT=3847
# HOST=0.0.0.0
